# Space Invaders Backend - Environment Variables
# Copy this file to .env and fill in your actual values

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# =============================================================================
DATABASE_URL=postgres://spaceinvaders:dev_password_change_in_prod@localhost:5432/spaceinvaders?sslmode=disable

# =============================================================================
# REDIS CACHE
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# RABBITMQ MESSAGE QUEUE
# =============================================================================
RABBITMQ_URL=amqp://spaceinvaders:dev_password_change_in_prod@localhost:5672/

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=3000
GIN_MODE=debug  # debug, release
JWT_SECRET=change_this_in_production_min_32_chars

# =============================================================================
# SOLANA BLOCKCHAIN CONFIGURATION
# =============================================================================
# Network: devnet, testnet, mainnet-beta
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Treasury wallet private key (base58 encoded)
# ⚠️ CRITICAL: Keep this secret! Use secrets manager in production
SOLANA_TREASURY_PRIVATE_KEY=

# SPACE token mint address
SOLANA_SPACE_MINT=

# Treasury wallet public key (for config)
TREASURY_WALLET_PUBKEY=

# =============================================================================
# ABACATEPAY PAYMENT INTEGRATION (PIX)
# =============================================================================
ABACATEPAY_API_KEY=
ABACATEPAY_BASE_URL=https://api.abacatepay.com/v1
ABACATEPAY_WEBHOOK_SECRET=

# For sandbox/testing, use:
# ABACATEPAY_BASE_URL=https://sandbox.abacatepay.com/v1

# =============================================================================
# IPFS/PINATA (NFT Metadata Storage)
# =============================================================================
PINATA_API_KEY=
PINATA_SECRET_KEY=

# =============================================================================
# SUPABASE (Migration Only - Legacy)
# =============================================================================
SUPABASE_URL=
SUPABASE_KEY=

# =============================================================================
# TREASURY & EMISSION CONFIGURATION
# =============================================================================
# These values are typically set in database via seed_treasury.sql
# Override here only if needed for testing/configuration

# Conversion ratio: Gold to SPACE (default: 100 Gold = 1 SPACE)
CONVERSION_RATIO=100

# Revenue share for daily emission calculation (default: 30%)
REVENUE_SHARE_PERCENT=0.30

# Daily emission limits in lamports (1 SPACE = 10^9 lamports)
MIN_EMISSION_PER_DAY=0
MAX_EMISSION_PER_DAY=1000000000000  # 1,000 SPACE tokens

# =============================================================================
# PRICE FETCHER CONFIGURATION
# =============================================================================
# Cache TTL for SPACE price (in seconds)
PRICE_CACHE_TTL=300  # 5 minutes

# Jupiter aggregator API (primary source)
JUPITER_API_URL=https://price.jup.ag/v4

# CoinGecko API (fallback)
COINGECKO_API_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=  # Optional, for higher rate limits

# =============================================================================
# WORKER CONFIGURATION
# =============================================================================
# Conversion worker (processes pending Gold→SPACE conversions)
CONVERSION_WORKER_ENABLED=true
CONVERSION_WORKER_POLL_INTERVAL=30s
CONVERSION_WORKER_BATCH_SIZE=10

# Emission cron job (daily SPACE emission calculation)
EMISSION_CRON_ENABLED=true
EMISSION_CRON_SCHEDULE=0 0 * * *  # Daily at midnight UTC
EMISSION_CRON_TIMEZONE=UTC

# =============================================================================
# LOGGING & MONITORING
# =============================================================================
LOG_LEVEL=info  # debug, info, warn, error
LOG_FORMAT=json  # json, text

# Prometheus metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=100

# =============================================================================
# DEVELOPMENT / TESTING
# =============================================================================
# Enable debug endpoints (admin tools, test utilities)
DEBUG_ENDPOINTS=false

# Automatically seed test data on startup
SEED_TEST_DATA=false

# Skip blockchain transactions (use mock adapter)
MOCK_BLOCKCHAIN=false

# =============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# =============================================================================
# Before deploying to production:
#
# ✅ Security:
#    - Generate strong JWT_SECRET (min 32+ random characters)
#    - Secure SOLANA_TREASURY_PRIVATE_KEY in secrets manager (AWS Secrets, Vault, etc.)
#    - Set strong database password
#    - Enable SSL for database (sslmode=require)
#    - Set ABACATEPAY_WEBHOOK_SECRET for webhook signature validation
#
# ✅ Solana:
#    - Set SOLANA_NETWORK=mainnet-beta
#    - Use mainnet RPC: https://api.mainnet-beta.solana.com (or paid RPC like QuickNode)
#    - Set production SOLANA_SPACE_MINT address
#    - Ensure treasury wallet has SOL for transaction fees
#    - Consider multisig wallet for treasury (2-of-3 or 3-of-5)
#
# ✅ Payments:
#    - Set production ABACATEPAY_API_KEY
#    - Use production URL: https://api.abacatepay.com/v1
#    - Test webhook integration thoroughly
#
# ✅ Performance:
#    - Set GIN_MODE=release
#    - Enable Redis caching
#    - Configure connection pools for database
#    - Set appropriate CORS_ALLOWED_ORIGINS
#
# ✅ Monitoring:
#    - Set LOG_LEVEL=warn or error
#    - Enable METRICS_ENABLED=true
#    - Set up Prometheus scraping
#    - Configure alerting for failed emissions/conversions
#
# ✅ Compliance:
#    - Disable DEBUG_ENDPOINTS=false
#    - Disable SEED_TEST_DATA=false
#    - Review and comply with local regulations for cryptocurrency
#    - Implement KYC/AML if required in your jurisdiction
#
# ✅ Backups:
#    - Set up automated database backups
#    - Backup treasury wallet keys securely (offline/cold storage)
#    - Document disaster recovery procedures
