# Space Invaders Backend - Local Docker Environment

# Database (Docker compose)
DATABASE_URL=postgres://spaceinvaders:dev_password_change_in_prod@postgres:5432/spaceinvaders?sslmode=disable
DB_PASSWORD=dev_password_change_in_prod
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# Server
API_PORT=8080
PORT=8080
GIN_MODE=debug
JWT_SECRET=change_this_in_production_min_32_chars_local_dev

# Solana (Devnet for testing)
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet
SOLANA_TREASURY_PRIVATE_KEY=
SOLANA_SPACE_MINT=
TREASURY_WALLET_PUBKEY=

# AbacatePay (empty for local dev)
ABACATEPAY_API_KEY=
ABACATEPAY_BASE_URL=https://api.abacatepay.com/v1
ABACATEPAY_WEBHOOK_SECRET=

# IPFS/Pinata (empty for local dev)
PINATA_API_KEY=
PINATA_SECRET_KEY=

# Treasury & Emission
CONVERSION_RATIO=100
REVENUE_SHARE_PERCENT=0.30

# Workers
CONVERSION_WORKER_ENABLED=true
EMISSION_CRON_ENABLED=true

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Rate Limiting
RATE_LIMIT_ENABLED=false

# Metrics
METRICS_ENABLED=true
PROMETHEUS_PORT=9091
